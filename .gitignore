# Arquivos que o rsconnect cria no seu computador ao publicar — são
# específicos de cada pessoa/máquina, não fazem sentido versionar.
rsconnect/

# Arquivos padrão do R / RStudio
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Obs.: os dados (dados/*.xlsx e dados/_cache_*.rds) ficam DENTRO do
# repositório de propósito — nenhum arquivo passa de 100MB, então não
# há motivo técnico para mantê-los fora. Ver README.md.
